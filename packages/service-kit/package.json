{
  "name": "@getir/service-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node servisleri icin gRPC acilis takimi: sunucu bootstrap, health RPC, Zod dogrulama ara katmani, AppError -> gRPC status cevirisi ve zarif kapanis",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "proto"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "example": "node dist/example/main.js",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@getir/core": "workspace:*",
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "pino": "^10.3.1",
    "zod": "^3.23.8"
  }
}
