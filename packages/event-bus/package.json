{
  "name": "@getir/event-bus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Servisler arasi olay hatti (ADR-07): zarf (D16'dan beri korelasyon alanlari), EventPublisher arayuzu, Redis Streams uygulamasi ve olay hattinda iz",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@getir/core": "workspace:*",
    "@getir/observability": "workspace:*",
    "@getir/redis-kit": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/redis": "^12.1.0"
  }
}
