{
  "name": "@getir/catalog-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Katalog servisi: urun, kategori ve dark store okuma uclari (gRPC)",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "node --watch dist/main.js",
    "start": "node dist/main.js",
    "healthcheck": "node dist/healthcheck.js",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@getir/core": "workspace:*",
    "@getir/proto": "workspace:*",
    "@getir/service-kit": "workspace:*",
    "@grpc/grpc-js": "^1.14.5",
    "zod": "^3.23.8"
  }
}
