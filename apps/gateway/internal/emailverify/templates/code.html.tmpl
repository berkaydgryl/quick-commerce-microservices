<!doctype html>
<html lang="tr">
  <body style="margin:0;padding:24px;background:#f5f5f5;font-family:Nunito,Arial,sans-serif;color:#191919">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:480px;margin:0 auto;background:#ffffff;border-radius:12px">
      <tr>
        <td style="padding:24px 24px 8px;font-size:24px;font-weight:800;color:#5d3ebc">getir</td>
      </tr>
      <tr>
        <td style="padding:8px 24px;font-size:16px;line-height:1.5">
          <p style="margin:0 0 12px">Merhaba {{.FullName}},</p>
          <p style="margin:0 0 16px">getir hesabına bu e-posta adresini eklemek için doğrulama kodun:</p>
          <p style="margin:0 0 16px;padding:16px;background:#f3f0fa;border-radius:8px;text-align:center;font-size:32px;font-weight:800;letter-spacing:8px;color:#5d3ebc">{{.Code}}</p>
          <p style="margin:0 0 12px">Kod {{.ValidMinutes}} dakika geçerli. Kodu kimseyle paylaşma.</p>
          <p style="margin:0 0 24px;color:#6b6b6b;font-size:14px">Bu isteği sen yapmadıysan bu e-postayı yok sayabilirsin; adresin hesaba eklenmez.</p>
        </td>
      </tr>
    </table>
  </body>
</html>
