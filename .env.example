# =============================================================================
# getir - hizli market mikroservis sistemi / ornek ortam degiskenleri
# =============================================================================
# Bu dosya SABLONDUR ve commit edilir. Gercek degerler icin kopyalayin:
#
#   PowerShell : Copy-Item .env.example .env
#   Git Bash   : cp .env.example .env
#
# .env dosyasi .gitignore tarafindan disarida tutulur; ASLA commit etmeyin.
#
# KURALLAR
#   - Tum para degerleri KURUS (minor unit) ve TAM SAYIDIR. Float yasaktir.
#     Ornek: 29,90 TL -> 2990
#   - Sureler adinda birimi tasir: *_MS = milisaniye, *_SECONDS = saniye.
#   - Buradaki degerler guvenli gelistirme varsayilanlaridir; uretimde
#     JWT_SECRET basta olmak uzere tum sirlar degistirilmelidir.


# =============================================================================
# ORTAK
# =============================================================================

# Calisma ortami: development | test | production
# Kod dallanmasi icin degil, yalnizca gunlukleme/hata ayrintisi icin kullanilir.
NODE_ENV=development

# Gunluk seviyesi: trace | debug | info | warn | error | fatal
# Gelistirmede "debug", CI ve uretimde "info" onerilir.
LOG_LEVEL=debug

# Sahte (mock) mod. true iken dis dunyaya cikilmaz:
# odeme saglayicisi, SMS/bildirim ve harita/mesafe servisleri deterministik
# sahte uygulamalarla degistirilir. Demo ve testler bu modda calisir.
MOCK=true


# =============================================================================
# ALTYAPI
# =============================================================================

# MongoDB baglanti dizesi.
# DIKKAT: Mongo tek dugumlu bir replica set (rs0) olarak calisir; cok belgeli
# transaction icin bu zorunludur. Node servisleri konteyner icinde DEGIL host'ta
# calistigindan surucunun topoloji kesfini atlamasi gerekir -> directConnection.
# "directConnection=true" ile "replicaSet=rs0" ayni URI'de BIRLIKTE KULLANILAMAZ;
# bu yuzden yalnizca directConnection yazilir.
MONGO_URI=mongodb://localhost:27017/getir?directConnection=true

# Uygulama veritabani adi. Testler bunun sonuna son ek ekler (orn. getir_test).
MONGO_DB=getir

# Surucunun uygun sunucuyu (PRIMARY) bulmak icin bekleyecegi en uzun sure (ms).
# Kisa tutulur: Mongo kapaliysa servis acilista HIZLICA olsun, istegi kabul edip
# saniyelerce bekletmesin.
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Redis baglanti dizesi (stok sayaclari, rezervasyon indeksi, oran sinirlama,
# idempotency kayitlari). Yapilandirmasi: infra/docker/redis.conf
REDIS_URL=redis://localhost:6379

# Ilk baglanti icin beklenecek en uzun sure (ms). Ayni gerekce: acilista hizli ol.
REDIS_CONNECT_TIMEOUT_MS=5000


# =============================================================================
# GATEWAY (apps/gateway - Go)
# =============================================================================

# Tarayicinin ve web uygulamasinin konustugu TEK giris noktasi.
GATEWAY_PORT=8080

# JWT imzalama sirri (HS256). Gelistirme disinda MUTLAKA degistirin; en az 32
# baytlik rastgele deger kullanin:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-insecure-secret-change-me

# Erisim jetonu omru (saniye). 3600 = 1 saat.
JWT_TTL=3600

# Yenileme jetonu omru (saniye). 1209600 = 14 gun.
REFRESH_TTL=1209600

# --- Oran sinirlama (rate limit) -------------------------------------------
# Kayan pencere Redis uzerinde tutulur; sinir IP + kullanici bazindadir.

# Oran sinirlamayi tamamen kapatmak icin false (yuk testlerinde kullanisli).
RATE_LIMIT_ENABLED=true

# Pencere uzunlugu (saniye).
RATE_LIMIT_WINDOW_SECONDS=60

# Pencere basina izin verilen genel istek sayisi.
RATE_LIMIT_MAX_REQUESTS=120

# Kimlik dogrulama uc noktalari icin daha dar sinir (kaba kuvvet savunmasi).
RATE_LIMIT_AUTH_MAX_REQUESTS=10

# Siparis olusturma icin dar sinir (cift siparis ve bot savunmasi).
RATE_LIMIT_ORDER_MAX_REQUESTS=20

# --- Idempotency -----------------------------------------------------------
# Idempotency-Key ile gonderilen yazma isteklerinin yaniti bu sure boyunca
# saklanir; ayni anahtarla gelen tekrar istek islemi YENIDEN CALISTIRMAZ,
# saklanan yaniti doner. 86400 = 24 saat.
IDEMPOTENCY_TTL_SECONDS=86400


# =============================================================================
# SERVIS PORTLARI
# =============================================================================
# gRPC servisleri yalnizca gateway ve birbirleri tarafindan cagrilir; disariya
# acilmaz. Prometheus metrik portu KURAL GEREGI servis portu + 1000'dir
# (orn. catalog 50051 -> metrics 51051). Ayrica tanimlanmaz, koddan turetilir.

# Node servislerinin dinledigi adres. Konteyner icinde 0.0.0.0 ZORUNLUDUR;
# 127.0.0.1 yazilirsa servis yalnizca kendi konteynerinden erisilebilir olur.
GRPC_HOST=0.0.0.0

# Zarif kapanista DEVAM EDEN cagrilarin bitmesi icin beklenecek en uzun sure (ms).
# Sure dolarsa sunucu zorla kapatilir. Kubernetes'in varsayilan 30 sn'lik
# terminationGracePeriod suresinin altinda kalmalidir.
GRPC_SHUTDOWN_TIMEOUT_MS=10000

CATALOG_GRPC_PORT=50051
INVENTORY_GRPC_PORT=50052
ORDER_GRPC_PORT=50053
PAYMENT_GRPC_PORT=50054
RISK_GRPC_PORT=50055
COURIER_GRPC_PORT=50056

# WebSocket / SSE sunucusu (kurye konumu, siparis durumu yayini).
REALTIME_PORT=3001

# React + Vite gelistirme sunucusu.
WEB_PORT=5173


# =============================================================================
# STOK / REZERVASYON
# =============================================================================
# Stok, sepete eklendiginde Redis'te atomik olarak REZERVE edilir. Rezervasyon
# suresi dolarsa stok otomatik iade edilir.
#
# ADR-02: Sure dolmasi Redis keyspace notification'a GUVENMEZ (garantisizdir ve
# yeniden baslatmada kaybolur). Gercek dogruluk kaynagi resv:index ZSET'i ve onu
# periyodik tarayan supurucudur (sweeper).

# Standart rezervasyon omru (saniye). 600 = 10 dakika.
RESERVATION_TTL_SECONDS=600

# Orta riskli kullanicilar icin kisaltilmis omur (saniye). 120 = 2 dakika.
# Risk skoru RISK_BAND_LOW_MAX ile RISK_BAND_MEDIUM_MAX arasinda olan
# kullanicilarda stok daha kisa sure bloke edilir.
RESERVATION_TTL_MEDIUM_RISK_SECONDS=120

# Her Charge / 3DS denemesinde rezervasyonun uzatilacagi sure (saniye).
# B21: 3DS kodu 60 sn gecerli ve 3 deneme hakki var; tek seferlik uzatma
# orta risk bandinda (TTL 120 sn) yetmiyordu. Uzatma deneme BASINA yapilir.
RESERVATION_EXTEND_SECONDS=60

# Bir rezervasyonun en fazla kac kez uzatilabilecegi (B21).
# 3 x 60 sn = 180 sn, ucuncu 3DS denemesini de kapsar. Ust sinir olmadan
# istemci rezervasyonu sinirsiz uzatip stoku kilitli tutabilirdi.
RESERVATION_MAX_EXTENSIONS=3

# Supurucunun resv:index ZSET'ini tarama araligi (milisaniye).
# Dusuk deger = daha hizli stok iadesi, daha fazla Redis trafigi.
SWEEPER_INTERVAL_MS=1000

# Supurucu dagitik kilidinin omru (saniye). Ayni anda yalnizca bir ornek
# supurme yapar; kilit sahibi cokerse en gec bu sure sonunda birakilir.
# SWEEPER_INTERVAL_MS'ten belirgin sekilde buyuk olmalidir.
SWEEPER_LOCK_TTL_SECONDS=3


# =============================================================================
# RISK
# =============================================================================
# Risk skoru 0-100 arasindadir. Bantlar KAPSAYICI ust sinirlardir:
#   [0 .. LOW_MAX]           -> dusuk  : normal akis
#   (LOW_MAX .. MEDIUM_MAX]  -> orta   : kisa rezervasyon omru
#   (MEDIUM_MAX .. HIGH_MAX] -> yuksek : ek dogrulama istenir
#   (HIGH_MAX .. 100]        -> kritik : siparis reddedilir
# Sihirli sayi birakmamak icin esikler burada isimlendirilmistir.

RISK_BAND_LOW_MAX=30
RISK_BAND_MEDIUM_MAX=65
RISK_BAND_HIGH_MAX=85


# =============================================================================
# KURYE
# =============================================================================

# Kurye konum simulasyonunun ilerleme adimi (milisaniye).
# Her tikta kurye rota uzerinde COURIER_SPEED_KMH hizina gore ilerletilir.
COURIER_TICK_MS=2000

# Simule edilen ortalama kurye hizi (km/saat). Sehir ici motokurye varsayimi.
COURIER_SPEED_KMH=20

# Istemciye geriye donuk gosterilen konum gecmisi uzunlugu (nokta sayisi).
# 30 nokta x 2000 ms = yaklasik son 1 dakikalik iz.
COURIER_TRACK_BUFFER=30


# =============================================================================
# FIYATLANDIRMA
# =============================================================================
# TUM DEGERLER KURUSTUR (minor unit, tam sayi). Float kullanmayin.

# Siparis verebilmek icin gereken en dusuk sepet tutari. 15000 = 150,00 TL
MIN_BASKET_MINOR=15000

# Standart teslimat ucreti. 2990 = 29,90 TL
DELIVERY_FEE_MINOR=2990

# Bu tutar ve uzerindeki sepetlerde teslimat ucretsizdir. 25000 = 250,00 TL
FREE_DELIVERY_THRESHOLD_MINOR=25000

# Tek bir urunden sepete eklenebilecek en fazla adet (stok istifleme savunmasi).
MAX_ITEM_QTY=30
