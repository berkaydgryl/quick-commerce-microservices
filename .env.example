# =============================================================================
# getir - hizli market mikroservis sistemi / ornek ortam degiskenleri
# =============================================================================
# Bu dosya SABLONDUR ve commit edilir. Gercek degerler icin kopyalayin:
#
#   PowerShell : Copy-Item .env.example .env
#   Git Bash   : cp .env.example .env
#
# .env dosyasi .gitignore tarafindan disarida tutulur; ASLA commit etmeyin.
#
# KURALLAR
#   - Tum para degerleri KURUS (minor unit) ve TAM SAYIDIR. Float yasaktir.
#     Ornek: 29,90 TL -> 2990
#   - Sureler adinda birimi tasir: *_MS = milisaniye, *_SECONDS = saniye.
#   - Buradaki degerler guvenli gelistirme varsayilanlaridir; uretimde
#     JWT_SECRET basta olmak uzere tum sirlar degistirilmelidir.


# =============================================================================
# ORTAK
# =============================================================================

# Calisma ortami: development | test | production
# Kod dallanmasi icin degil, yalnizca gunlukleme/hata ayrintisi icin kullanilir.
NODE_ENV=development

# Gunluk seviyesi: trace | debug | info | warn | error | fatal
# Gelistirmede "debug", CI ve uretimde "info" onerilir.
LOG_LEVEL=debug

# Sahte (mock) mod. true iken dis dunyaya cikilmaz:
# odeme saglayicisi, SMS/bildirim ve harita/mesafe servisleri deterministik
# sahte uygulamalarla degistirilir. Demo ve testler bu modda calisir.
MOCK=true


# =============================================================================
# ALTYAPI
# =============================================================================

# MongoDB - SERVIS BASINA veritabani ve kullanici (D14, ADR-05).
# Her servis (gateway dahil) KENDI veritabanina KENDI kullanicisiyla baglanir;
# kullanici yalnizca o veritabaninda okur ve yazar (readWrite). Baska servisin
# koleksiyonuna erisim Mongo tarafindan reddedilir.
#
# Node servisleri ve gateway MOCK=false iken kendi adreslerini zorunlu tutar;
# seed komutlari (pnpm seed, pnpm seed:personas) her zaman ister.
#
# Yerel compose (pnpm infra:up) bu dosyayi okur: kok kullaniciyi ve asagidaki
# adreslerdeki servis kullanicilarini ILK acilista olusturur. Kullanici, parola
# ve veritabani tek yerde, burada tanimlidir. Ilk acilistan sonra parola ya da
# kullanici degisirse hacim sifirlanir: pnpm infra:reset (infra/docker/README.md).
#
# DIKKAT: Mongo tek dugumlu bir replica set (rs0) olarak calisir; cok belgeli
# transaction icin bu zorunludur. Node servisleri konteyner icinde DEGIL host'ta
# calistigindan surucunun topoloji kesfini atlamasi gerekir -> directConnection.
# "directConnection=true" ile "replicaSet=rs0" ayni URI'de BIRLIKTE KULLANILAMAZ;
# bu yuzden yalnizca directConnection yazilir. Kullanicilar admin veritabaninda
# tanimlidir -> authSource=admin. Parolalar YALNIZCA yerel gelistirme icindir;
# uretimde her servise ayri, guclu parola verilir.

# Kok kullanici: yalnizca compose (replica set kurulumu, saglik yoklamasi) ve
# elle yonetim (mongosh) icin. Servisler bu kullaniciyla BAGLANMAZ.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=root-dev-only

# Servis adresi (kullanici:parola) ve veritabani. Veritabani verilmezse
# servisin varsayilani kullanilir (getir_<servis>); testler kendi adini verir.
CATALOG_MONGO_URI=mongodb://catalog:catalog-dev-only@localhost:27017/?directConnection=true&authSource=admin
CATALOG_MONGO_DB=getir_catalog
INVENTORY_MONGO_URI=mongodb://inventory:inventory-dev-only@localhost:27017/?directConnection=true&authSource=admin
INVENTORY_MONGO_DB=getir_inventory
ORDER_MONGO_URI=mongodb://order:order-dev-only@localhost:27017/?directConnection=true&authSource=admin
ORDER_MONGO_DB=getir_order
PAYMENT_MONGO_URI=mongodb://payment:payment-dev-only@localhost:27017/?directConnection=true&authSource=admin
PAYMENT_MONGO_DB=getir_payment
RISK_MONGO_URI=mongodb://risk:risk-dev-only@localhost:27017/?directConnection=true&authSource=admin
RISK_MONGO_DB=getir_risk
# Kurye (T13.1): couriers koleksiyonu.
COURIER_MONGO_URI=mongodb://courier:courier-dev-only@localhost:27017/?directConnection=true&authSource=admin
COURIER_MONGO_DB=getir_courier
# Gateway (Go): users ve sessions koleksiyonlari (T8.1).
GATEWAY_MONGO_URI=mongodb://gateway:gateway-dev-only@localhost:27017/?directConnection=true&authSource=admin
GATEWAY_MONGO_DB=getir_gateway

# Surucunun uygun sunucuyu (PRIMARY) bulmak icin bekleyecegi en uzun sure (ms).
# Kisa tutulur: Mongo kapaliysa servis acilista HIZLICA olsun, istegi kabul edip
# saniyelerce bekletmesin. Butun servislerde ortak.
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Node servislerinde bir Mongo isleminin (ya da transaction'in) ust suresi (ms, #51;
# 100-60000). Mongo cevap vermeden donarsa cagri bu surede SERVICE_UNAVAILABLE
# doner; transaction geri almayla en gec iki katinda. Gateway'in istek suresinin
# (GATEWAY_REQUEST_TIMEOUT_MS) altinda kalmali. Acilistaki goc ve indeks kurulumu,
# seed ve migrate komutlari bu sureyle sinirlanmaz. Gateway (Go) kendi Mongo
# islemlerini GATEWAY_REQUEST_TIMEOUT_MS ile sinirlar.
MONGO_OPERATION_TIMEOUT_MS=2000

# Redis baglanti dizesi (stok sayaclari, rezervasyon indeksi, oran sinirlama,
# idempotency kayitlari; order-service olaylari stream:events'e yayinlar, T7.3;
# payment-service iade komutlarini oradan dinler, T7.4; gateway Idempotency-Key
# kayitlarini tutar, T8.2; courier-service tick liderligi, courier.picked_up /
# courier.delivered olaylari ve canli konum, T13.3). Order, payment, courier ve
# gateway MOCK=false iken zorunlu tutar; gateway Redis'e ulasamazsa acilmaz.
# Yapilandirmasi: infra/docker/redis.conf
REDIS_URL=redis://localhost:6379

# Ilk baglanti icin beklenecek en uzun sure (ms). Ayni gerekce: acilista hizli ol.
REDIS_CONNECT_TIMEOUT_MS=5000

# Dagitik izleme (D15, ADR-20): izlerin gonderilecegi OTLP/HTTP taban adresi.
# docker-compose'daki Jaeger dinler; arayuz http://localhost:16686. Gateway ve
# Node servisleri ayni degiskeni okur. Bos birakilirsa izler yine olusur ve
# servisten servise tasinir (gunluk satirinda traceId), yalnizca disari
# gonderilmez. Ad OpenTelemetry'nin standart adidir.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318


# =============================================================================
# GATEWAY (apps/gateway - Go)
# =============================================================================

# Tarayicinin ve web uygulamasinin konustugu TEK giris noktasi.
GATEWAY_PORT=8080

# Gateway'in konustugu gRPC servislerinin ADRESI (host:port). Port degil adres
# tutulur: gateway konteynerde calisirken servis baska bir konteyner adinda
# olabilir (orn. catalog:50051). Yerelde varsayilanlar yeterlidir.
# CATALOG_GRPC_ADDR'i order-service de okur: taslak siparisin fiyatlari catalog'dan (T7.2).
CATALOG_GRPC_ADDR=localhost:50051
# Stok servisi (T8.4): gateway urun listesine satilabilir adetleri buradan ekler (B27).
# order-service de okur: taslakta stok kilidi, odemede kesinlestirme (T11.2).
INVENTORY_GRPC_ADDR=localhost:50052
ORDER_GRPC_ADDR=localhost:50053
# Siparis saga'si (T7.1): order-service risk ve odeme servislerini cagirir.
RISK_GRPC_ADDR=localhost:50055
PAYMENT_GRPC_ADDR=localhost:50054
# Kurye atama (T13.1): order-service odenen siparise courier-service'ten kurye ister.
COURIER_GRPC_ADDR=localhost:50056

# Tek bir bagimli servise yapilan cagrinin ust siniri (ms), /healthz dahil.
# Servisler paralel sorgulandigi icin /healthz en fazla bu kadar bekler.
GATEWAY_REQUEST_TIMEOUT_MS=5000

# Urun listesindeki stok sorgusunun ust siniri (ms, T8.4). Asilirsa liste
# stoksuz doner ("stok bilgisi yok"); genel sinir kadar beklenmez.
GATEWAY_STOCK_TIMEOUT_MS=300

# Gorsellerin mutlak adresinin koku. ZORUNLU, varsayilani YOK: verilmezse
# gateway acilmaz (fail fast). Veri gorseli GORELI yol olarak saklar
# ("/img/cat/sut.png"); gateway istemciye giden cevapta bu koku ekler:
#   http://localhost:5173/img/cat/sut.png
# Neden varsayilan yok: gorsellerin nerede barinacagi (web public/, CDN) henuz
# kararlastirilmadi ve canli ortamda unutulan bir varsayilan istemciye sessizce
# localhost adresi gonderirdi. Asagidaki deger yalnizca yerel bir ORNEKTIR.
# Kural: http(s) ile baslar, sorgu (?) ve parca (#) tasimaz.
ASSET_BASE_URL=http://localhost:5173

# JWT imzalama sirri (HS256). ZORUNLU, en az 32 bayt. Gelistirme disinda MUTLAKA
# degistirin: NODE_ENV=production iken bu ornek deger REDDEDILIR ve gateway
# acilmaz. Rastgele deger uretmek icin:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sir degisirse onceki erisim jetonlari gecersiz olur (kullanici yeniden girer).
JWT_SECRET=dev-only-insecure-secret-change-me

# Erisim jetonu omru (saniye). 3600 = 1 saat.
JWT_TTL=3600

# Siparis odasi jetonunun imza sirri (HS256, T12.2). ZORUNLU, en az 32 bayt.
# Gateway GET /v1/orders/{id}/token'da imzalar, realtime-service room.join'de
# AYNI degerle dogrular: iki servise de ayni deger verilir. JWT_SECRET'tan
# FARKLI olmali (gateway ayniysa acilmaz): biri sizarsa digeri gecerli kalir.
# Realtime JWT_SECRET'i hic bilmez. NODE_ENV=production iken bu ornek deger
# REDDEDILIR. Uretmek icin: openssl rand -hex 32
# Realtime MOCK=true iken bos birakilabilir: siparis odalari kapali kalir.
REALTIME_TOKEN_SECRET=dev-only-insecure-realtime-secret-change-me

# Yenileme jetonu omru (saniye). 1209600 = 14 gun. Son kullanimdan itibaren
# sayilir: her yenilemede jeton degisir ve sure yeniden baslar. Jeton govdede
# degil, gateway'in yazdigi HttpOnly cerezde (getir_refresh) tasinir.
REFRESH_TTL=1209600

# --- Oran sinirlama (rate limit) -------------------------------------------
# Kayan pencere Redis uzerinde tutulur (T8.2, roadmap P2); gateway ornekleri
# ayni sayaci paylasir. Sayim uc basinadir: kimliksiz uclarda (katalog, kimlik)
# IP, kimlik isteyen uclarda kullanici sayilir. Sinir asilinca 429 +
# Retry-After. Redis'e ulasilamazsa istek GECER (fail-open); MOCK=true iken
# sayac gateway'in belleginde tutulur.

# Oran sinirlamayi tamamen kapatmak icin false (yuk testlerinde kullanisli).
RATE_LIMIT_ENABLED=true

# Pencere uzunlugu (saniye).
RATE_LIMIT_WINDOW_SECONDS=60

# Pencere basina izin verilen genel istek sayisi.
RATE_LIMIT_MAX_REQUESTS=120

# Kayit ve giris icin daha dar sinir (kaba kuvvet savunmasi). Yenileme ve cikis
# genel sinirdadir: web her acilista sessizce yeniler (T8.5).
RATE_LIMIT_AUTH_MAX_REQUESTS=10

# Rezervasyon, siparis ve 3DS icin dar sinir (cift siparis ve bot savunmasi).
RATE_LIMIT_ORDER_MAX_REQUESTS=20

# --- Idempotency -----------------------------------------------------------
# Idempotency-Key ile gonderilen yazma isteklerinin yaniti bu sure boyunca
# saklanir; ayni anahtarla gelen tekrar istek islemi YENIDEN CALISTIRMAZ,
# saklanan yaniti doner. 86400 = 24 saat. Basarili siparis ve 3DS kaydi bundan
# bagimsiz olarak 2 saat tutulur (ADR-08 eki, T8.2).
IDEMPOTENCY_TTL_SECONDS=86400

# --- Harita adres servisi (T11.8) ------------------------------------------
# Adres ekleme penceresinde pinin adres satiri ve sokak aramasi. Kaynak
# OpenStreetMap'in ucretsiz Nominatim'i; kullanim kosulu saniyede en fazla BIR
# istek ve uygulamayi tanitan User-Agent'tir. Gateway butun istekleri tek
# siraya dizer ve cevaplari 24 saat onbellekler; tarayici Nominatim'e gitmez.
# Kendi Nominatim'ini kuran ortam kok adresi degistirir (sorgu/parca tasimaz).
GEO_BASE_URL=https://nominatim.openstreetmap.org
GEO_USER_AGENT=getir-demo-gateway/1.0 (+https://github.com/berkaydgryl/quick-commerce-microservices)

# Tek adres sorusunun ust siniri (ms): sirada bekleme + Nominatim cevabi.
# Asilirsa SERVICE_UNAVAILABLE; kullanici adresini elle yazabilir.
GEO_TIMEOUT_MS=5000

# --- E-posta dogrulama (T11.14) --------------------------------------------
# Profilde e-posta adresine 6 haneli kod gider (ADR-12 eki). Gelistirmede SMTP
# sunucusu compose'daki Mailpit'tir: ileti disari cikmaz, http://localhost:8025
# arayuzunde gorunur. Bicim smtp://host:port; kullanici adi/parola ve TLS bugun
# YOK (bekleyen is #90). Bos birakilirsa gelistirmede bu adres, MOCK=true'da
# bellek (ileti hicbir yere yazilmaz); NODE_ENV=production iken ZORUNLU.
SMTP_URL=smtp://localhost:1025

# Iletinin gondereni: "Ad <adres>" ya da yalnizca adres.
MAIL_FROM="getir <no-reply@getir.local>"

# Tek iletinin ust siniri (ms): baglanti + teslim. Asilirsa kod istegi
# SERVICE_UNAVAILABLE doner ve kod silinir (kullanici beklemeden yeniden ister).
SMTP_TIMEOUT_MS=5000


# =============================================================================
# SERVIS PORTLARI
# =============================================================================
# gRPC servisleri yalnizca gateway ve birbirleri tarafindan cagrilir; disariya
# acilmaz. Prometheus metrik portu KURAL GEREGI servis portu + 1000'dir
# (orn. catalog 50051 -> metrics 51051). Ayrica tanimlanmaz, koddan turetilir.

# Node servislerinin dinledigi adres. Konteyner icinde 0.0.0.0 ZORUNLUDUR;
# 127.0.0.1 yazilirsa servis yalnizca kendi konteynerinden erisilebilir olur.
GRPC_HOST=0.0.0.0

# Zarif kapanista DEVAM EDEN cagrilarin bitmesi icin beklenecek en uzun sure (ms).
# Sure dolarsa sunucu zorla kapatilir. Kubernetes'in varsayilan 30 sn'lik
# terminationGracePeriod suresinin altinda kalmalidir.
GRPC_SHUTDOWN_TIMEOUT_MS=10000

CATALOG_GRPC_PORT=50051
INVENTORY_GRPC_PORT=50052
ORDER_GRPC_PORT=50053
PAYMENT_GRPC_PORT=50054
RISK_GRPC_PORT=50055
COURIER_GRPC_PORT=50056

# Realtime (Socket.io, T12.1): siparis ve market odalari, yalnizca websocket.
# Metrik ucu kural geregi +1000 (4001); saglik GET /healthz ayni portta.
# MOCK=false iken REDIS_URL'e baglanir (Redis adapter: kopyalar odalari paylasir).
REALTIME_PORT=3001

# React + Vite gelistirme sunucusu.
WEB_PORT=5173


# =============================================================================
# STOK / REZERVASYON
# =============================================================================
# Stok, sepete eklendiginde Redis'te atomik olarak REZERVE edilir. Rezervasyon
# suresi dolarsa stok otomatik iade edilir.
#
# ADR-02: Sure dolmasi Redis keyspace notification'a GUVENMEZ (garantisizdir ve
# yeniden baslatmada kaybolur). Gercek dogruluk kaynagi resv:index ZSET'i ve onu
# periyodik tarayan supurucudur (sweeper).

# Standart rezervasyon omru (saniye). 600 = 10 dakika. order-service taslakta
# kilidi bu omurle ister (T11.2); inventory 30-900 disini reddeder, order da
# acilista ayni araligi dogrular.
RESERVATION_TTL_SECONDS=600

# order-service'in supurucusu (T11.2 PR 2): kilidi dolan taslak ve odeme
# bekleyen siparisleri bu aralikla kapatir (ms; 1000-600000). Parasi alinmis
# olani iade eder. Kullaniciya gorunen davranis buna bagli degil.
ORDER_SWEEPER_INTERVAL_MS=10000

# Orta riskli kullanicilar icin kisaltilmis omur (saniye). 120 = 2 dakika.
# order-service okur (T11.3): kilit taslakta RESERVATION_TTL_SECONDS ile alinir,
# risk adiminda orta bantta kalan sure en cok bu kadar olur (inventory
# ShortenReservation). 30-900.
RESERVATION_TTL_MEDIUM_RISK_SECONDS=120

# Odeme oncesi uzatma (saniye; order-service okur, T11.3, B21). Cekimden ve her
# 3DS onayindan ONCE kalan sure bundan azsa kilit bu kadar uzatilir (inventory
# ExtendReservation; hak RESERVATION_MAX_EXTENSIONS). Kalan sure yetiyorsa
# uzatma cagrisi yapilmaz. 1-300.
RESERVATION_EXTEND_SECONDS=60

# Bir rezervasyonun en fazla kac kez uzatilabilecegi (B21; inventory-service okur,
# T11.3). 3 x 60 sn = 180 sn, ucuncu 3DS denemesini de kapsar. Ust sinir olmadan
# istemci rezervasyonu sinirsiz uzatip stoku kilitli tutabilirdi. 0-10; 0 uzatmayi kapatir.
RESERVATION_MAX_EXTENSIONS=3

# Supurucunun resv:index ZSET'ini tarama araligi (milisaniye; inventory-service, T10.3).
# Dusuk deger = daha hizli stok iadesi, daha fazla Redis trafigi. 100 - 60000.
SWEEPER_INTERVAL_MS=1000

# Supurucu dagitik kilidinin omru (saniye). Ayni anda yalnizca bir ornek
# supurme yapar; kilit sahibi cokerse en gec bu sure sonunda birakilir.
# SWEEPER_INTERVAL_MS'ten belirgin sekilde buyuk olmalidir: en az iki tur (servis
# acilista dogrular; degilse acilmaz). 1 - 60.
SWEEPER_LOCK_TTL_SECONDS=3


# =============================================================================
# RISK
# =============================================================================
# Risk skoru 0-100 arasindadir. Bantlar KAPSAYICI ust sinirlardir:
#   [0 .. LOW_MAX]           -> dusuk  : normal akis
#   (LOW_MAX .. MEDIUM_MAX]  -> orta   : kisa rezervasyon omru
#   (MEDIUM_MAX .. HIGH_MAX] -> yuksek : ek dogrulama istenir
#   (HIGH_MAX .. 100]        -> kritik : siparis reddedilir
# Sihirli sayi birakmamak icin esikler burada isimlendirilmistir.

RISK_BAND_LOW_MAX=30
RISK_BAND_MEDIUM_MAX=65
RISK_BAND_HIGH_MAX=85


# =============================================================================
# KURYE
# =============================================================================

# Kurye konum simulasyonunun ilerleme adimi (milisaniye, 200-60000; T13.3).
# Her tikta rotalar bu ana getirilir: paket alindi / teslim edildi olaylari
# yayinlanir, teslimde kurye bosa cikar. Birden cok kopyada tek lider tikler.
COURIER_TICK_MS=2000

# Simule edilen ortalama kurye hizi (km/saat, tam sayi 1-120). Sehir ici motokurye varsayimi.
# T13.2'den beri atamadaki varis tahmini de buradan: ETA = ceil(rota m / (hiz / 3,6)) sn.
# Varsayilan 20 (gercekci). Demoda 45'e cikarilabilir: teslimat birkac dakikada biter.
COURIER_SPEED_KMH=20

# Siparisin markette hazirlanma suresi (saniye, 0-3600; T13.3). Kurye markete
# daha erken varirsa paketi bu sure dolunca alir. Bos birakilirsa 300; demo icin 30.
ORDER_PREP_SECONDS=30

# Istemciye geriye donuk gosterilen konum gecmisi uzunlugu (nokta sayisi).
# 30 nokta x 2000 ms = yaklasik son 1 dakikalik iz.
COURIER_TRACK_BUFFER=30


# =============================================================================
# FIYATLANDIRMA
# =============================================================================
# TUM DEGERLER KURUSTUR (minor unit, tam sayi). Float kullanmayin.

# Siparis verebilmek icin gereken en dusuk sepet tutari. 15000 = 150,00 TL
MIN_BASKET_MINOR=15000

# Standart teslimat ucreti. 2990 = 29,90 TL
DELIVERY_FEE_MINOR=2990

# Bu tutar ve uzerindeki sepetlerde teslimat ucretsizdir. 25000 = 250,00 TL
FREE_DELIVERY_THRESHOLD_MINOR=25000

# Tek bir urunden sepete eklenebilecek en fazla adet (stok istifleme savunmasi).
MAX_ITEM_QTY=30
